#!/usr/bin/env bash

case "$1 $2" in
  'pane layout')
    printf '%s\n' '{"result":{"pane":{"width":200}}}'
    ;;
  'pane split')
    if [ "${SIDO_E2E_MODE:-}" = 'split-fail' ]; then
      exit 42
    fi
    printf '%s\n' '{"result":{"pane":{"pane_id":"fake-pane"}}}'
    ;;
  'pane run')
    # exec-array layout: $3=paneID $4=receiverBin $5=_inner_prompt_receiver
    #                   $6=promptFile $7=fifo $8=dir $9=shimPid $10=paneID
    if [ "${SIDO_E2E_MODE:-}" = 'fail' ]; then
      exit 42
    fi
    if [ "${SIDO_E2E_MODE:-}" = 'orphan' ]; then
      # Simulate a blocking receiver: hold the FIFO write end open (so the
      # shim sees a connected writer) and log our pid. Real orphan cleanup is
      # exercised by running the real receiver under a pty.
      ( exec 3>"$7"; while true; do sleep 1; done ) &
      echo "$!" > "$SIDO_E2E_RECEIVER_LOG"
      exit 0
    fi
    printf '%s\n' 'fake-password' > "$7"
    ;;
  'pane close')
    printf '%s\n' "$3" >> "$SIDO_E2E_PANE_LOG"
    if [ "${SIDO_E2E_MODE:-}" = 'orphan' ]; then
      kill "$(cat "$SIDO_E2E_RECEIVER_LOG")" 2>/dev/null
    fi
    ;;
esac
